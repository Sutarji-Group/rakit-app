# ---------------------------------------------------------------------------
# RAKIT — variabel lingkungan
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Basis data — PostgreSQL
# ---------------------------------------------------------------------------
# DATABASE_URL : koneksi yang dipakai aplikasi saat berjalan.
# DIRECT_URL   : koneksi langsung tanpa pooler, dipakai `prisma migrate`.
#
# Lokal: keduanya sama.
# Produksi serverless (Vercel/Neon/Supabase): DATABASE_URL menunjuk ke pooler
# dan wajib membawa `?pgbouncer=true&connection_limit=1`, DIRECT_URL menunjuk
# ke host database aslinya (port 5432, tanpa parameter tambahan).
DATABASE_URL="postgresql://postgres:PASSWORD@127.0.0.1:5432/rakit?schema=public"
DIRECT_URL="postgresql://postgres:PASSWORD@127.0.0.1:5432/rakit?schema=public"

# Kunci penandatanganan sesi (JWT). WAJIB diganti di produksi.
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# URL publik aplikasi, dipakai untuk tautan berbagi & PDF.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Informasi perusahaan pada dokumen penawaran.
NEXT_PUBLIC_COMPANY_NAME="Rakit"
NEXT_PUBLIC_COMPANY_LEGAL="PT Rakit Teknologi Nusantara"
NEXT_PUBLIC_COMPANY_EMAIL="halo@rakit.id"
NEXT_PUBLIC_COMPANY_PHONE="+62 811 1000 200"
NEXT_PUBLIC_COMPANY_ADDRESS="Jl. Rasuna Said Kav. 12, Jakarta Selatan 12950"
